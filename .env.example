# Backend configuration. Copy to .env and fill in. Never commit .env.
GROQ_API=
GROQ_MODEL=openai/gpt-oss-120b
PINECONE_API=
PINECONE_ENV=us-east-1
SUPABASE_URL=
SUPABASE_ANON_KEY=

# eCourtsIndia partner API. Create a key at https://ecourtsindia.com/dashboard/api/keys
# Server-side only: never give this a VITE_ prefix, which would ship it to browsers.
ECOURTS_API_KEY=

# Optional
# CREATE_PINECONE_INDEX=true   # index the PDFs in the Supabase pdfs bucket on startup
# HOST=0.0.0.0                 # needed inside containers
# CORS_ORIGINS=https://your-frontend.example,http://localhost:5173
# TRUST_PROXY=1            # set only when running behind a reverse proxy
# ECOURTS_USER_DAILY_BUDGET_INR=10    # per signed-in user, per day
# ECOURTS_DAILY_BUDGET_INR=50         # whole app, per day
# GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# CHAT_LIMIT_PER_MINUTE=20
